# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=AI Voice Agent

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai-voice-agent

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sarvam AI ────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_API_URL=https://api.sarvam.ai/v1

# ── STT Provider ─────────────────────────────────────
STT_PROVIDER=whisper
OPENAI_API_KEY=your_openai_api_key

# ── TTS Provider ─────────────────────────────────────
TTS_PROVIDER=sarvam

# ── Telephony ────────────────────────────────────────
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WEB_SOCKET_URL=http://localhost:3001

# Razorpay (use test key for dev, live key for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
